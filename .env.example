# Server
PORT=5100
JWT_PRIVATE_KEY=change_me_local_dev_key

# Payment provider: square (default) | legacy
PAYMENT_PROVIDER=square
PAYMENT_MODE=authorize_capture
# authorize_capture = authorize at booking, capture when admin takes payment (default)
# charge_immediate = charge in full at booking time
# charge_on_take = same as authorize_capture (alias)

# Square — see square.env.example and src/config/squareCredentials.js
SQUARE_ENV=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_SANDBOX_WEBHOOK_NOTIFICATION_URL=http://localhost:5100/api/v1/webhooks/square

# Production (uncomment when live; set SQUARE_ENV=production)
# SQUARE_PRODUCTION_ACCESS_TOKEN=
# SQUARE_PRODUCTION_APPLICATION_ID=
# SQUARE_PRODUCTION_LOCATION_ID=
# SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
# SQUARE_PRODUCTION_WEBHOOK_NOTIFICATION_URL=https://api.yourdomain.com/api/v1/webhooks/square

# Socket.IO — see docs/socket-io-production.md
SOCKET_IO_PATH=/api/v1/socket.io
SOCKET_CORS_ORIGINS=https://odatransportation.com,https://www.odatransportation.com,http://localhost:3000
SOCKET_ROOM_JWT_SECRET=change_me_socket_room_secret

# Database (PostgreSQL) — defaults match src/config/database.js
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=oda_transportation
# DB_USER=postgres
# DB_PASSWORD=postgres123
