<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Booking Rejected</title>
</head>

<body style="
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
      margin: 0;
      padding: 0;
    ">
  <table style="
        width: 100%;
        max-width: 600px;
        margin: 20px auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      ">
    <tr>
      <td style="text-align: center; padding: 20px 0;">
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">

          <div
            style="text-align: center; padding: 32px 0; background-color: #ffffff; margin-bottom: 20px; border-bottom: 2px solid #f0f0f0;">
            <img src="https://odatransportation.com/static/media/ODA_Primary%20Logo.6715e0b164c507dbe1f2.png"
              alt="ODA Transportation Logo" style="max-width: 200px; height: auto;" />
          </div>
        </div>
      </td>
    </tr>
    <tr>
      <td style="text-align: center">
        <h1 style="color: #dc3545">Booking Rejected</h1>
      </td>
    </tr>
    <tr>
      <td>
        <p>Dear <%= name %>,</p>
        <p>
          We regret to inform you that your booking has been rejected. The
          details are as follows:
        </p>
        <ul>
          <p><strong>Booking Type:</strong>
            <%= bookingType %>
          </p>
          <p><strong>Pickup Location:</strong>
            <%= pickupLocation %>
          </p>
          <p><strong>Pickup Date:</strong>
            <%= pickupDate %>
          </p>
          <p><strong>Reason for Rejection:</strong>
            <%= rejectionReason %>
          </p>
        </ul>
        <p>
          If you have any questions or would like to discuss further, please
          don't hesitate to contact us.
        </p>
        <p>Best regards,<br />Oda Transportation</p>
      </td>
    </tr>
  </table>
</body>

</html>