<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Booking Accepted</title>
</head>

<body>
  <div class="container">
    <div
      style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
      <div
        style="text-align: center; padding: 32px 0; background-color: #ffffff; margin-bottom: 20px; border-bottom: 2px solid #f0f0f0;">
        <img src="https://odatransportation.com/static/media/Odaa%20Transportation%20-%20Logo_Primary%20Logo.391dbf01f07d5f1b361d.png"
          alt="ODA Black Car Service Logo" style="max-width: 200px; height: auto;" />
      </div>
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto">
        <h2 style="color: green">Booking Accepted</h2>
        <p style="color: none">Dear <%= name %>,</p>
        <p style="color: none">
          Your booking has been accepted for your
          reservation of car service on <%= reservationDate %> at <%= reservationTime %>.
        </p>
        <p style="color: none">
          For any questions or further
          assistance, feel free to reach out to us at 714-313-4269.
        </p>

        <!-- Contact Details -->
        <h3 style="color: white; background-color: black; padding: 5px">
          Contact Details:
        </h3>
        <table cellspacing="0" cellpadding="5" style="border-collapse: collapse">
          <tbody>
            <% Object.entries(contactDetails).forEach(([key, value])=> { %>
              <tr>
                <td style="border: none">
                  <%= key %>
                </td>
                <td style="border: none">
                  <%= value %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>

        <!-- Reservation Details -->
        <h3 style="color: white; background-color: black; padding: 5px">
          Reservation Details:
        </h3>
        <table cellspacing="0" cellpadding="5" style="border-collapse: collapse">
          <tbody>
            <% Object.entries(reservationDetails).forEach(([key, value])=> { %>
              <tr>
                <td style="border: none">
                  <%= key %>
                </td>
                <td style="border: none">
                  <%= value %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>

        <!-- Fare Details -->
        <h3 style="color: white; background-color: black; padding: 5px">
          Fare Details:
        </h3>
        <table cellspacing="0" cellpadding="5" style="border-collapse: collapse">
          <tbody>
            <% Object.entries(fareDetails).forEach(([key, value])=> { %>
              <tr>
                <td style="border: none">
                  <%= key %>
                </td>
                <td style="border: none">
                  <%= value %>
                </td>
              </tr>
              <% }); %>
                <tr>
                  <td style="border: none; font-weight: bold; background-color: gray">
                    Total Fare
                  </td>
                  <td style="
                border: none;
                font-weight: bold;
                background-color: gray;
                font-size: 1.2em;
              ">
                    <%= totalFare %>
                  </td>
                </tr>
          </tbody>
        </table>

        <!-- Additional Message -->
        <h3 style="color: white; background-color: black; padding: 5px">
          Additional Message:
        </h3>
        <p>
          For more information on your Car & Limo Reservation status or
          Cancellation contact us on: 714-313-4269<br />
        </p>
        <p>
          <strong><u>Cancellation Policy:</u></strong>
        </p>
        <p>
          Next Day Early Morning Pickup Cancellation can be done before 9:00PM or
          4 Hours Prior Notice has to be by Phone / E-Mail
        </p>
        <p>
          <strong style="color: black">ODA Black Car Service </strong>
        </p>
        <p style="color: #007bff">
          714-313-4269<br />
          California 90046<br />
          United States<br />
          info@odatransportation.com<br />
          <a href="http://www.odatransportation.com" style="color: #007bff">www.odatransportation.com</a><br />
        </p>
      </div>
    </div>
  </div>
</body>

</html>