# =============================================================================
# Square credentials — copy into ODA-TRANSPORTATION/.env
# Single module: src/config/squareCredentials.js
# Switch active set: SQUARE_ENV=sandbox | production
# =============================================================================

SQUARE_ENV=sandbox

# --- Sandbox (Square Developer Dashboard → Sandbox) ---
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_SANDBOX_WEBHOOK_NOTIFICATION_URL=http://localhost:5100/api/v1/webhooks/square

# --- Production (fill when going live) ---
# SQUARE_PRODUCTION_ACCESS_TOKEN=
# SQUARE_PRODUCTION_APPLICATION_ID=
# SQUARE_PRODUCTION_LOCATION_ID=
# SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=<from Square → Webhooks → subscription details>
# SQUARE_PRODUCTION_WEBHOOK_NOTIFICATION_URL=https://api.odatransportation.com/api/v1/webhooks/square

# --- Optional legacy names (fallback if *_SANDBOX_* / *_PRODUCTION_* unset) ---
# SQUARE_ACCESS_TOKEN=
# SQUARE_APPLICATION_ID=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_NOTIFICATION_URL=

# SQUARE_VERSION=2025-07-16
